# Groq API key (free & recommended for fast inference: https://console.groq.com/keys)
LLM_API_KEY=your_groq_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace token (optional fallback)
HF_API_TOKEN=your_huggingface_token_here

# Port (7860 is default for HuggingFace Spaces, 5000 for local dev)
PORT=7860
FLASK_PORT=7860
APP_ENV=production
